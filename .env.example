# Copy to services/cost-api/.env for local API; never commit actual secrets.
DATABASE_URL=sqlite:///./arkemx-dev.db
# Production example: postgresql+psycopg://cost_user:secret@localhost:5432/cost
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
UPLOAD_DIR=./data/uploads
ENVIRONMENT=development
